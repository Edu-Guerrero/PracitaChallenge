    {
      "name": "Accounts - OK",
      "item": [
        {
          "name": "List accounts (default pagination) - 200",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Response is PagedAccountsResponse-like', function () {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property('content');",
                  "  pm.expect(json).to.have.property('page');",
                  "  pm.expect(json).to.have.property('size');",
                  "  pm.expect(json).to.have.property('totalElements');",
                  "  pm.expect(json.content).to.be.an('array');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "List accounts (filter by customerId=Marianela) - 200",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/accounts?customerId={{existingCustomerIdMarianela}}",
