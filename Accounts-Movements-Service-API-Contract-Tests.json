            },
            "url": { "raw": "{{baseUrl}}/accounts", "host": ["{{baseUrl}}"], "path": ["accounts"] }
          },
          "event": [
            {
              "listen": "test",
              "script": { "type": "text/javascript", "exec": [
                "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
                "pm.test('Location header exists', function () { pm.expect(pm.response.headers.get('Location')).to.be.ok; });",
                "pm.test('Response looks like AccountResponse', function () {",
