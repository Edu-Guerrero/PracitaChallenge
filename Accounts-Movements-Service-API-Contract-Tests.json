              "script": { "type": "text/javascript", "exec": [
                "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                "pm.test('AccountResponse shape', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json).to.have.property('id');",
                "  pm.expect(json).to.have.property('accountNumber');",
                "  pm.expect(json).to.have.property('type');",
                "  pm.expect(json).to.have.property('initialBalance');",
                "  pm.expect(json).to.have.property('currentBalance');",
                "  pm.expect(json).to.have.property('status');",
                "  pm.expect(json).to.have.property('customerId');",
                "});",
                "pm.test('Seeded account matches BaseDatos.sql (225487 CHECKING initialBalance=100)', function () {",
                "  const json = pm.response.json();",
                "  pm.expect(json.accountNumber).to.eql('225487');",
                "  pm.expect(json.type).to.eql('CHECKING');",
                "  pm.expect(Number(json.initialBalance)).to.eql(100);",
                "  pm.expect(json.customerId).to.eql(pm.collectionVariables.get('existingCustomerIdMarianela'));",
                "});"
              ] }
